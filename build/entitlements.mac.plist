<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Standard hardened-runtime allowances electron-builder apps need -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<!-- Needed for the native @hamitzor/rtaudio.js addon (not signed by the
	     same Team ID as this app) to load under the hardened runtime -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- HTTP/WebSocket server (Companion, remote control, browser UI) and
	     outbound requests -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- This app plays audio only; it never records -->
	<key>com.apple.security.device.audio-input</key>
	<false/>
</dict>
</plist>
