{
  "name": "accompaniment",
  "version": "2.0.5-beta",
  "private": true,
  "description": "acCompaniment soundboard. The app is the Rust binary in rust/app; this package holds the test tooling (node:test, Playwright).",
  "author": "Marcin Wardecki",
  "homepage": "https://github.com/mko1989/acCompaniment/",
  "license": "MIT",
  "scripts": {
    "build": "cargo build --release --manifest-path rust/app/Cargo.toml",
    "start": "npm run build && rust/app/target/release/accompaniment",
    "test": "npm run build && npm run test:unit && npm run test:smoke && npm run test:e2e",
    "test:rust": "cargo test --release --manifest-path rust/app/Cargo.toml",
    "test:unit": "npm run test:rust && node --test test/unit/*.test.js",
    "test:smoke": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:audio": "node --test --test-concurrency=1 test/audio/*.test.js",
    "test:audio:ui": "ACCOMPANIMENT_AUDIO_UI=1 playwright test",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.js"
  },
  "devDependencies": {
    "@hamitzor/rtaudio.js": "^2.2.0",
    "@playwright/test": "^1.63.0",
    "prebuild": "file:scripts/npm-stubs/prebuild",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "@hamitzor/rtaudio.js": {
      "cmake-js": "^8.0.0",
      "prebuild": "$prebuild"
    }
  }
}
