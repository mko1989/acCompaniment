{
  "schema": "rust-anything/app-cases@1",
  "name": "accompaniment",
  "run": [
    "env",
    "ACCOMPANIMENT_DATA_DIR=rust/app-fixtures/data",
    "HOST=127.0.0.1",
    "rust/app/target/release/accompaniment"
  ],
  "normalize": [
    "key-order",
    "timestamps",
    "uuids"
  ],
  "normalizers": {
    "filestamp": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{3}Z",
    "ports": "\"(httpPort|websocketPort)\":[0-9]+|(127\\.0\\.0\\.1|localhost|[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+):[0-9]+",
    "timing": "\"(startTime|currentTime|positionSec)\":(0\\.[0-9eE+-]+|[1-9][0-9.eE+-]*)",
    "workdir": "rust-anything-app-server[-0-9]*"
  },
  "timeout_secs": 900,
  "http": {
    "fresh": [
      "rust/app-fixtures/data",
      "rust/app-fixtures/incoming"
    ],
    "pace_ms": 500
  },
  "effects": {
    "db_dump": "node /Users/marcin/CascadeProjects/acCompaniment-NODEtoRUST/rust/scripts/dump-data.js rust/app-fixtures/data"
  }
}
