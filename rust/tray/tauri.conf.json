{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "acCompaniment",
  "version": "2.0.0-beta.2",
  "identifier": "com.highpass.acCompaniment",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Soundboard for live shows",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/accompaniment-server"],
    "resources": {
      "../../src/frontend/": "frontend/"
    }
  }
}
